CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# the app is installed by the airflash updater into ota_0; this table is only used for the build's size check
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# this example has no networking of its own, so airflash connects to Wi-Fi (set SSID/password in menuconfig → airflash)
CONFIG_AIRFLASH_WIFI_ENABLE=y
# crash dumps go to the "coredump" partition (the updater layout has one); read them with airflash.py coredump
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
